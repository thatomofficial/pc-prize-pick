<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PcPrizePick.Application\PcPrizePick.Application.csproj" />
    <ProjectReference Include="..\PcPrizePick.Domain\PcPrizePick.Domain.csproj" />
    <ProjectReference Include="..\PcPrizePick.SharedKernel\PcPrizePick.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EF Core Design assets flow transitively to the API startup project so
      the dotnet ef tooling can resolve them. PrivateAssets is relaxed to
      "contentfiles;analyzers" so build assets reach consumers while content
      and analyzers stay scoped here. Version is managed centrally in
      Directory.Packages.props.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>contentfiles;analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="AspNetCore.HealthChecks.NpgSql" />
  </ItemGroup>

</Project>
