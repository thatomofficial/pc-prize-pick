<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PcPrizePick.Application\PcPrizePick.Application.csproj" />
    <ProjectReference Include="..\PcPrizePick.Domain\PcPrizePick.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EF Core Design assets need to flow transitively to the API project so
      the dotnet ef tooling (run with startup-project pointing at the API)
      can resolve them. PrivateAssets is relaxed to "contentfiles;analyzers"
      so build assets reach consumers, but content and analyzers stay
      scoped to this project.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.*">
      <PrivateAssets>contentfiles;analyzers</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.*" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
