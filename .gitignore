# Repo-wide ignores. Per-app gitignores live in Frontend/ and Backend/.

# Editor / IDE — local state only
.history/
.idea/
*.swp
*.swo
*~

# VS Code — only ignore a root-level .vscode/. Per-app .vscode/ folders are
# governed by each app's own .gitignore (which allows the standard four files).
/.vscode/

# Claude Code local-only settings (never commit personal permissions)
.claude/settings.local.json
.claude/.session*
.claude/scheduled_tasks.lock

# OS
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Env files (placed by humans at repo root or app root — keep them out of git)
.env
.env.local
.env.*.local
*.local

# Node — defensive, in case anyone runs npm at root by mistake
/node_modules

# .NET build output — defensive, in case anyone runs dotnet at root
/bin
/obj

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Misc
.tmp/
.cache/

# Scraper outputs (tools/pc-prebuild-scraper)
tools/**/out/
tools/**/output/
tools/**/.spec-cache/
